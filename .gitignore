# TTS Cache - 音频缓存文件通常很大，不应该上传到 Git（但保留 _index.json）
cache/tts_cache/**/*.mp3
cache/tts_cache/**/*.wav
cache/tts_cache/**/*.flac
cache/tts_cache/**/*.aac
cache/tts_cache/**/*.ogg
!cache/tts_cache/**/_index.json

# Cache directories - 所有缓存文件（但保留索引和目录结构）
cache/**/*.mp3
cache/**/*.wav
cache/**/*.flac
cache/**/*.aac
cache/**/*.ogg
!cache/**/_index.json
# 保留声纹注册音频目录结构，但忽略音频文件
!cache/speaker_verification_audio/
# 忽略所有音频文件，除了在 cache/speaker_verification_audio/ 中的 .wav 文件（我们想保留用于注册）

# Pretrained models - 不提交预训练模型
pretrained/
pretrained/**/*.bin
pretrained/**/*.pt
pretrained/**/*.pth
pretrained/**/*.ckpt
pretrained/**/*.onnx
pretrained/**/*.safetensors

# Environment variables
.env
.env.local
.env.*.local

# Temporary files
*.tmp
*.temp
*.bak
*.backup

# Model files (if any large model files)
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Audio files (except small test files if needed)
*.mp3
*.wav
